# Identifiants de connexion SSH pour chaque machine du cluster
CREDS = {
    "oreille": {"user": "votre_utilisateur", "pass": "votre_password"},
    "cerveau": {"user": "votre_utilisateur", "pass": "votre_password"},
    "bouche":  {"user": "votre_utilisateur", "pass": "votre_password"},
    "mqtt": {"user": "votre_utilisateur", "pass": "votre_password!"}
}

# Adresses IP statiques des machines sur le réseau local
OREILLE_IP = "192.168.1.XX"
CERVEAU_IP = "192.168.1.XX"
BOUCHE_IP  = "192.168.1.XX"
MQTT_IP = "192.168.1.XX"

 
